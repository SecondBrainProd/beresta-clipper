{
  "manifest_version": 3,
  "name": "Beresta Clipper",
  "version": "0.1.0",
  "description": "Отправляет открытую страницу в Beresta — статьёй во «Входящие».",
  "icons": {
    "128": "icon.png"
  },
  "permissions": ["activeTab", "scripting", "notifications", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "action": {
    "default_title": "В Beresta",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html"
  }
}
