{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "browser_specific_settings": {
    "gecko": {
      "id": "clipper@beresta.page",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "activeTab",
    "notifications",
    "storage",
    "alarms",
    "http://127.0.0.1/*"
  ],
  "browser_action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "scripts": [
      "outbox.js",
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html"
  },
  "default_locale": "en",
  "homepage_url": "https://beresta.page",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
